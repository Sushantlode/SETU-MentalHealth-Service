{
  "name": "stress-quantification-device-booking",
  "version": "1.0.0",
  "description": "Backend for booking Stress Quantification Device",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "setup": "node setup.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
